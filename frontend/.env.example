# Leave blank for local development; Vite proxies /api to localhost:3001.
# Vercel production uses the same-origin function proxy in frontend/api/.
# For GitHub Pages, set this at build time to the public Render API origin.
VITE_API_BASE_URL=
# Optional for a Vercel custom domain (the *.vercel.app hostname is automatic).
VITE_USE_SAME_ORIGIN_API=false
