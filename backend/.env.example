NODE_ENV=development
API_PORT=3001

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=myproject
DB_USER=jharakhand_database
DB_PASSWORD=replace-with-your-local-mysql-password

# Generate with: openssl rand -base64 48
SESSION_SECRET=replace-with-at-least-32-random-characters-before-running

# Both localhost and 127.0.0.1 are included because browsers treat them as different origins.
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
COOKIE_SAME_SITE=lax
